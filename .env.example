# Server-only Gemini key for AI diagnostics. Never prefix this secret with VITE_.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# The URL this app is served from. Cloudflare Pages production uses https://electician-office.pages.dev.
APP_URL="http://localhost:5173"
